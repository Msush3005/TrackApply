# Backend
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
PORT=4000
FRONTEND_URL=http://localhost:3000

# Cookie / Deployment options
# COOKIE_SAMESITE: 'lax' (default) or 'none' for cross-site cookies (production + HTTPS required)
# COOKIE_SECURE: 'true' or 'false' (defaults to true in production)
# COOKIE_DOMAIN: optional domain to scope the cookie (e.g. .example.com)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Proxy & rate limit options
# TRUST_PROXY=1  # set to 1 when behind a proxy (Vercel, Render, etc.)
TRUST_PROXY=0
# AUTH_RATE_LIMIT_WINDOW_MS and AUTH_RATE_LIMIT_MAX control auth route rate limiting (applied to /api/auth)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# LOGIN_RATE_LIMIT_* are stricter limits for the login endpoint
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
